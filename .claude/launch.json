{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "event-hall-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "event-hall-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "event-hall-prod-devcal",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ZOHO_REFRESH_TOKEN=", "npx", "next", "start", "-p", "3001"],
      "port": 3001
    }
  ]
}
