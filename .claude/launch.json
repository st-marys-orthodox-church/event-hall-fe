{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "event-hall-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "event-hall-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "event-hall-prod-devcal",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ZOHO_REFRESH_TOKEN=", "npx", "next", "start", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "voice-stubs",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/voice-smoke.mjs", "--stubs"],
      "port": 4610
    },
    {
      "name": "event-hall-voice-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_VOICE_ENABLED=1",
        "NEXT_PUBLIC_CHAT_ENABLED=1",
        "BYTEPLUS_OPENAPI_URL=http://127.0.0.1:4610",
        "BYTEPLUS_ACCESS_KEY_ID=AKSMOKE",
        "BYTEPLUS_SECRET_ACCESS_KEY=smoke-secret-access-key",
        "BYTEPLUS_RTC_APP_ID=0123456789abcdef01234567",
        "BYTEPLUS_RTC_APP_KEY=smoke-rtc-app-key",
        "BYTEPLUS_ASR_APP_ID=smoke-asr-app",
        "BYTEPLUS_ASR_ACCESS_TOKEN=smoke-asr-token",
        "BYTEPLUS_TTS_APP_ID=smoke-tts-app",
        "BYTEPLUS_TTS_TOKEN=smoke-tts-token",
        "VOICE_LLM_SECRET=smoke-llm-secret",
        "VOICE_PUBLIC_BASE_URL=http://localhost:3002",
        "CHAT_PROVIDER=modelark",
        "MODELARK_API_KEY=smoke-model-key",
        "MODELARK_MODEL=smoke-model",
        "MODELARK_BASE_URL=http://127.0.0.1:4610/api/v3",
        "npx",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "event-hall-admin-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ADMIN_PASSCODE=local-hub-passcode",
        "ADMIN_DIRECTORY_JSON={\"yelp\":{\"owner\":\"Sample Owner\",\"backupOwner\":\"Sample Backup\",\"credentialsIn\":\"Password manager\",\"reviewedOn\":\"2026-10-01\"},\"facebook\":{\"owner\":\"Same Person\",\"backupOwner\":\"Same Person\"}}",
        "npx",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3003"
      ],
      "port": 3003
    }
  ]
}
