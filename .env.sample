# ─────────────────────────────────────────────────────────────────────────────
# Fellowship Event Hall — environment variables
#
# Local dev:  cp .env.sample .env.local   then fill in the real values.
# Production: add these in Vercel → Settings → Environment Variables.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# NEVER put a secret behind a NEXT_PUBLIC_ name.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ───────────────────────────────────

# Venue phone number — single source of truth for the tel: link, the displayed
# number, the structured data, and the WhatsApp deep link. The wa.me digits are
# derived from this by stripping non-digits, so KEEP THE COUNTRY CODE (+1 …),
# otherwise WhatsApp links break.
NEXT_PUBLIC_PHONE=+1-404-518-1042

# GA4 measurement id. Unset = no analytics script is loaded at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console "HTML tag" verification token (the content= value only).
# Not needed if you verify via the GA4 tag or DNS instead.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to 1 to show the AI chat widget. Leave unset until GEMINI_API_KEY works
# on the deployment, otherwise visitors only ever see its error message.
# NEXT_PUBLIC_CHAT_ENABLED=1

# Set to 1 to offer a voice call inside the chat widget ("Talk to us"). English
# only, and it needs the chat widget on (NEXT_PUBLIC_CHAT_ENABLED=1) plus every
# BYTEPLUS_* and VOICE_* secret below. Leave unset until those are in place:
# while it is unset the /api/voice/* routes answer 404. See docs/voice-agent.md.
# NEXT_PUBLIC_VOICE_ENABLED=1

# Set to 1 locally so the contact form logs submissions to the server console
# instead of sending real email through SendGrid. Leave UNSET in production.
NEXT_PUBLIC_DEV=1

# ── Secrets (server-only — do NOT add a NEXT_PUBLIC_ prefix) ──────────────────

# SendGrid API key, used by /api/sendgrid to deliver contact-form emails.
# Never give this a NEXT_PUBLIC_ prefix: that marks a value as safe for browsers.
SENDGRID_API_KEY=your-sendgrid-api-key

# Private iCal feed read by /api/availability to mark booked vs. free dates.
CALENDAR_ICS_URL=https://calendar.example.com/ical/your-feed-id/feed.ics

# OPTIONAL. Public "church events" iCal feed (shared with full details, English
# titles). Read by /api/availability, the home page, and /events to show the
# parish's public events as open invitations. Leave unset to hide the feature.
# PUBLIC_EVENTS_ICS_URL=https://calendar.example.com/ical/public-events-id/feed.ics

# OPTIONAL. Zoho Calendar API credentials for self-serve viewing bookings
# (/api/viewings/*). Create a "Self Client" at https://api-console.zoho.com with
# scopes ZohoCalendar.calendar.READ,ZohoCalendar.event.ALL, exchange the grant
# code for a refresh token once, and use the uid of a dedicated "Viewings"
# calendar so a junk booking can never block an event date. Unset = the booking
# flow tells visitors to contact us instead. With NEXT_PUBLIC_DEV=1 and these
# unset, bookings are kept in memory so the flow can be tested locally.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_VIEWINGS_CALENDAR_UID=
# Only for Zoho accounts outside the US data centre (e.g. https://accounts.zoho.eu).
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_CALENDAR_URL=https://calendar.zoho.com

# Google Gemini API key (https://aistudio.google.com/apikey). Powers the site
# chat agent (/api/chat). Unset = the endpoint reports not_configured.
GEMINI_API_KEY=your-gemini-api-key

# OPTIONAL. Model used by the chat agent. Defaults to gemini-3.8-flash;
# gemini-3.5-flash-lite is the low-cost option.
# CHAT_MODEL=gemini-3.8-flash

# OPTIONAL. Which LLM backs the chat agent: gemini (default) or modelark (BytePlus).
# CHAT_PROVIDER=gemini
# BytePlus ModelArk, used when CHAT_PROVIDER=modelark. MODELARK_MODEL is a model ID or an
# inference endpoint ID (ep-...) from the ModelArk console.
# MODELARK_API_KEY=your-modelark-api-key
# MODELARK_MODEL=your-model-or-endpoint-id
# MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ── Voice agent (BytePlus RTC) ── all needed when NEXT_PUBLIC_VOICE_ENABLED=1 ──
# Where each value comes from, step by step: docs/voice-agent.md.

# Access key pair that signs the StartVoiceChat / StopVoiceChat calls. Create it
# for an IAM sub-user limited to RTC, not for the main account:
# BytePlus console → IAM → Key management.
# BYTEPLUS_ACCESS_KEY_ID=
# BYTEPLUS_SECRET_ACCESS_KEY=

# The RTC application. AppId names it (the browser sees this one); AppKey signs
# the room tokens and must stay secret. RTC console → Application Management.
# BYTEPLUS_RTC_APP_ID=
# BYTEPLUS_RTC_APP_KEY=

# Seed Speech credentials: speech-to-text (ASR) hears the visitor, text-to-speech
# (TTS) is the agent's voice. Seed Speech console → the service's API access page.
# BYTEPLUS_ASR_APP_ID=
# BYTEPLUS_ASR_ACCESS_TOKEN=
# BYTEPLUS_TTS_APP_ID=
# BYTEPLUS_TTS_TOKEN=

# Any long random string (e.g. `openssl rand -hex 32`). BytePlus calls our
# /api/voice/llm/ on every turn of a call; the key it presents and the session
# it carries are both derived from this. Changing it ends the calls in progress.
# VOICE_LLM_SECRET=

# OPTIONAL. The https origin BytePlus reaches this deployment at, without a
# path. Defaults to the production site; set it on a preview deployment that
# should take its own calls (the URL must be reachable without a login).
# VOICE_PUBLIC_BASE_URL=https://events.saintmaryro.org

# OPTIONAL. The agent's voice: a "Speaker ID" from the Seed Speech voice list
# (TTS 2.0, English). Avoid the ones marked "Unidirectional Streaming Only".
# VOICE_TTS_SPEAKER=en_female_lana_del_rey_parky_s_p1_uranus_bigtts

# OPTIONAL. Spending limits. A call is cut off after this many seconds (the
# agent can run up to 180 s longer if the visitor just closes the tab), and no
# more than this many calls are started per day. The daily count is kept in
# memory per server instance, so treat it as a brake, not an exact budget.
# VOICE_MAX_SESSION_SECONDS=360
# VOICE_DAILY_SESSION_CAP=40

# OPTIONAL. BytePlus's API host and signing region. The docs use the defaults
# below; BytePlus's sample app uses https://rtc.ap-southeast-1.byteplusapi.com
# with region ap-southeast-1. Try that pair if calls fail to sign.
# BYTEPLUS_OPENAPI_URL=https://open.byteplusapi.com
# BYTEPLUS_OPENAPI_REGION=ap-singapore-1

# OPTIONAL. JSON merged over the `Config` of StartVoiceChat, to change a setting
# without a code change, e.g. {"TTSConfig":{"Provider":"byteplus_Bidirectional_streaming"}}
# VOICE_CONFIG_OVERRIDES=

# Google Places API key — OPTIONAL. Only used locally by `pnpm reviews:sync`
# to download the reviewers' Google profile photos into public/reviews/
# (needs "Places API (New)" enabled on the key). The site itself never calls
# Google. GOOGLE_PLACE_ID skips the by-name lookup; the script prints it.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# OPTIONAL. Model `pnpm i18n:sync` uses (GEMINI_API_KEY above); falls back to CHAT_MODEL.
# Without a key the script writes [ES]/[RO] stubs.
# I18N_MODEL=gemini-3.8-flash

# OPTIONAL. Team hub at /admin/ (account owners, listing details, how-tos). Unset = the
# page answers 404. The passcode is shared with the team; use 12+ characters. Changing it
# signs everyone out.
# ADMIN_PASSCODE=
# Who owns which account, keyed by the ids in src/utils/AdminAccounts.ts. The repo is
# public, so this lives here and never in code. Never put passwords in it: credentialsIn
# says where the password is kept (e.g. "1Password, Events vault"). Fields per account:
# owner, backupOwner, loginEmail, credentialsIn, twoFactor, reviewedOn, notes.
# ADMIN_DIRECTORY_JSON={"google-business":{"owner":"Name","backupOwner":"Name","loginEmail":"events@saintmaryro.org","credentialsIn":"1Password, Events vault","twoFactor":"Office phone","reviewedOn":"2026-10-01"}}

# ── Optional / tooling ────────────────────────────────────────────────────────

# Override the canonical site URL used for sitemap + robots.txt generation.
# Defaults to https://events.saintmaryro.org when unset.
# SITE_URL=https://events.saintmaryro.org

# Set to 'true' to enable the webpack bundle analyzer during `pnpm build`.
# ANALYZE=false
