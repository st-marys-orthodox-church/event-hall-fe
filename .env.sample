# ─────────────────────────────────────────────────────────────────────────────
# Fellowship Event Hall — environment variables
#
# Local dev:  cp .env.sample .env.local   then fill in the real values.
# Production: add these in Vercel → Settings → Environment Variables.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# NEVER put a secret behind a NEXT_PUBLIC_ name.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe to expose to the browser) ───────────────────────────────────

# Venue phone number — single source of truth for the tel: link, the displayed
# number, the structured data, and the WhatsApp deep link. The wa.me digits are
# derived from this by stripping non-digits, so KEEP THE COUNTRY CODE (+1 …),
# otherwise WhatsApp links break.
NEXT_PUBLIC_PHONE=+1-404-518-1042

# GA4 measurement id. Unset = no analytics script is loaded at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console "HTML tag" verification token (the content= value only).
# Not needed if you verify via the GA4 tag or DNS instead.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set to 1 to show the AI chat widget. Leave unset until ANTHROPIC_API_KEY works
# on the deployment, otherwise visitors only ever see its error message.
# NEXT_PUBLIC_CHAT_ENABLED=1

# Set to 1 locally so the contact form logs submissions to the server console
# instead of sending real email through SendGrid. Leave UNSET in production.
NEXT_PUBLIC_DEV=1

# ── Secrets (server-only — do NOT add a NEXT_PUBLIC_ prefix) ──────────────────

# SendGrid API key, used by /api/sendgrid to deliver contact-form emails.
# Never give this a NEXT_PUBLIC_ prefix: that marks a value as safe for browsers.
SENDGRID_API_KEY=your-sendgrid-api-key

# Private iCal feed read by /api/availability to mark booked vs. free dates.
CALENDAR_ICS_URL=https://calendar.example.com/ical/your-feed-id/feed.ics

# OPTIONAL. Public "church events" iCal feed (shared with full details, English
# titles). Read by /api/availability, the home page, and /events to show the
# parish's public events as open invitations. Leave unset to hide the feature.
# PUBLIC_EVENTS_ICS_URL=https://calendar.example.com/ical/public-events-id/feed.ics

# OPTIONAL. Zoho Calendar API credentials for self-serve viewing bookings
# (/api/viewings/*). Create a "Self Client" at https://api-console.zoho.com with
# scopes ZohoCalendar.calendar.READ,ZohoCalendar.event.ALL, exchange the grant
# code for a refresh token once, and use the uid of a dedicated "Viewings"
# calendar so a junk booking can never block an event date. Unset = the booking
# flow tells visitors to contact us instead. With NEXT_PUBLIC_DEV=1 and these
# unset, bookings are kept in memory so the flow can be tested locally.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_VIEWINGS_CALENDAR_UID=
# Only for Zoho accounts outside the US data centre (e.g. https://accounts.zoho.eu).
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_CALENDAR_URL=https://calendar.zoho.com

# Anthropic API key. Powers the site chat agent (/api/chat) and lets
# `pnpm i18n:sync` auto-translate new English strings into es/ro (without it the
# script writes [ES]/[RO] stubs).
ANTHROPIC_API_KEY=your-anthropic-api-key

# OPTIONAL. Model used by the chat agent. Defaults to claude-opus-5;
# claude-haiku-4-5 is the low-cost option.
# CHAT_MODEL=claude-opus-5

# ── Optional / tooling ────────────────────────────────────────────────────────

# Override the canonical site URL used for sitemap + robots.txt generation.
# Defaults to https://events.saintmaryro.org when unset.
# SITE_URL=https://events.saintmaryro.org

# Set to 'true' to enable the webpack bundle analyzer during `pnpm build`.
# ANALYZE=false
